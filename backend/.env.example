# Supabase Backend Environment Variables
# Copy this file to .env and fill in your project credentials

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service role key (keep secret - full database access)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon key (safe for frontend use)
SUPABASE_ANON_KEY=your-anon-key

# Database connection string (for direct Postgres access)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
